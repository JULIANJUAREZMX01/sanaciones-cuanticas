---
import Base from '@/layouts/Base.astro';
import { CONTACTO } from '@/data/contenido.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const VIAS = [
  { t: 'WhatsApp', d: 'La vía más rápida. Escríbenos y en el mismo día acordamos horario.', href: CONTACTO.whatsappTexto, btn: 'Escribir por WhatsApp' },
  { t: 'Llamada telefónica', d: 'Si prefieres hablar, marcamos y resolvemos dudas en voz alta.', href: CONTACTO.telefono, btn: 'Llamar ' + CONTACTO.telefonoTexto },
  { t: 'Videollamada', d: 'Sesión en línea por WhatsApp o Skype. Solo necesitas un lugar tranquilo y audífonos.', href: CONTACTO.whatsapp, btn: 'Pedir enlace de videollamada' },
  { t: 'Presencial', d: 'Consultorio en Calle Limón 618, entre Sabino y Ébano, frente a la guardería Chiquitines.', href: 'https://www.google.com/maps/search/?api=1&query=Calle+Lim%C3%B3n+618+Chapultepec', btn: 'Ver ubicación en el mapa' },
];
---
<Base title="Agendar una sesión · Sanaciones Cuánticas Energéticas" description="Agenda por WhatsApp, llamada telefónica, videollamada o cita presencial en Calle Limón 618, Col. Chapultepec.">
  <section class="bloque" style="padding-top:clamp(1.6rem,4vw,3rem)">
    <div class="wrap">
      <p class="kicker">Agenda</p>
      <h1>Elige cómo quieres hablar</h1>
      <p class="lead" style="max-width:40rem">La primera conversación no tiene costo. Si decides avanzar, te enviamos el cuestionario de treinta preguntas y se te informa cuándo queda aprobada tu solicitud.</p>
    </div>
  </section>
  <section class="bloque">
    <div class="wrap">
      <div class="grid3">
        {VIAS.map((v) => (
          <article class="card">
            <h3>{v.t}</h3>
            <p>{v.d}</p>
            <a class="btn btn-sec" style="margin-top:.6rem" href={v.href} target={v.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{v.btn}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="bloque">
    <div class="wrap creadora">
      <div>
        <p class="kicker">Consultorio</p>
        <h2>Dónde se atiende</h2>
        <p><strong>Calle Limón 618</strong><br />Colonia Chapultepec<br />entre calle Sabino y Ébano<br />frente a la guardería Chiquitines</p>
        <p>Las sesiones presenciales se agendan con anticipación para asegurar privacidad y tranquilidad. Si llegas en transporte público, escríbenos y te compartimos referencias.</p>
        <div class="btns">
          <a class="btn btn-pri" href={CONTACTO.whatsappTexto}>Agendar por WhatsApp</a>
          <a class="btn btn-sec" href="https://www.google.com/maps/search/?api=1&query=Calle+Lim%C3%B3n+618+Chapultepec" target="_blank" rel="noopener">Abrir mapa</a>
        </div>
      </div>
      <div class="marco"><img src={`${base}/img/colibri.webp`} alt="Colibrí ornamental" width="1024" height="1024" /></div>
    </div>
  </section>
  <section class="bloque">
    <div class="wrap">
      <h2>Antes de tu primera cita</h2>
      <div class="grid3" style="margin-top:1rem">
        <article class="card"><h3>1. Responde el cuestionario</h3><p>Treinta preguntas para conocerte. Puedes hacerlo en línea sin llamada previa.</p></article>
        <article class="card"><h3>2. Espera la aprobación</h3><p>Hay una pre-aprobación y la aprobación final de la Lic. Dra. Rosa Patricia Alvarado Moreno.</p></article>
        <article class="card"><h3>3. Prepara tu espacio</h3><p>Ropa cómoda, lugar tranquilo, agua. Si es en línea: audífonos y datos estables.</p></article>
      </div>
      <p style="margin-top:1.2rem"><a href={`${base}/cuestionario/`}>Ir al cuestionario de primer encuentro →</a></p>
    </div>
  </section>
</Base>
