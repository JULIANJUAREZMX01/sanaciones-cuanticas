---
import Base from '@/layouts/Base.astro';
import { FASES, CONTACTO } from '@/data/contenido.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const RESPUESTAS = [
  ['Respiración', 'Se hace más lenta y profunda, a veces con un suspiro largo al soltar.'],
  ['Temperatura', 'Calor en manos, pecho o vientre; en ocasiones frescor en la frente.'],
  ['Sensación', 'Hormigueo, vibración suave, pesadez agradable en brazos y piernas.'],
  ['Emoción', 'Aparición de llanto, risa o nostalgia sin causa inmediata.'],
  ['Cuerpo', 'Micro-movimientos, mandíbula que se destensa, hombros que bajan.'],
  ['Tiempo', 'Pérdida de la noción del tiempo o sensación de que pasó muy rápido.'],
];
---
<Base title="El Método Convergencia · cómo se trabaja" description="Documentación del método: Método Yujuen, inducción personal, lenguaje cuántico como metáfora, consentimiento por fases y criterios de aprobación.">
  <section class="bloque" style="padding-top:clamp(1.6rem,4vw,3rem)">
    <div class="wrap">
      <p class="kicker">Documento del método</p>
      <h1>El Método Convergencia</h1>
      <p class="lead" style="font-size:1.05rem;max-width:44rem">Tres prácticas distintas que se ordenan en un solo procedimiento: el Método Yujuen como base de presencia, la inducción personal como palabra que guía y el lenguaje cuántico como forma de nombrar la conexión. Este documento explica qué hacemos, por qué y hasta dónde llega.</p>
      <div class="disclaimer" style="margin-top:1.4rem">
        <strong>Principio de honestidad.</strong> Este acompañamiento no diagnostica, no trata ni cura enfermedades. No afirmamos que la entrelazación de partículas explique la sanación humana: la física cuántica se usa aquí como metáfora de vínculo y presencia, no como mecanismo terapéutico demostrado. Lo que sí observamos con regularidad es relajación profunda, alivio del estrés y una sensación de integración.
      </div>
    </div>
  </section>

  <section class="bloque">
    <div class="wrap">
      <h2>Las seis fases del procedimiento</h2>
      <div class="fases">
        {FASES.map((f) => (<div class="fase"><div><h3>{f.t}</h3><p>{f.d}</p></div></div>))}
      </div>
    </div>
  </section>

  <section class="bloque">
    <div class="wrap">
      <h2>Los tres lenguajes que convergen</h2>
      <div class="grid3" style="margin-top:1.2rem">
        <article class="card pilar"><h3>Método Yujuen</h3><p>El fundamento del procedimiento. Se practica con presencia sostenida, silencio y atención plena: el acompañante no empuja ni interpreta por ti, sostiene el espacio para que tu propio sistema se ordene. No es una creencia religiosa ni exige fe: exige disposición y permiso.</p></article>
        <article class="card pilar j"><h3>Inducción personal</h3><p>Relato hablado, construido con las palabras del consultante: respiración, imaginería, recuerdos seguros y frases de permiso. No se impone un guion: se redacta para esa persona.</p></article>
        <article class="card pilar c"><h3>Lenguaje cuántico</h3><p>Hablamos de partículas enlazadas y de vínculo a distancia porque es una imagen potente para nombrar lo que se mantiene conectado. Es metáfora consciente: no es una explicación física de la enfermedad ni de la curación.</p></article>
      </div>
    </div>
  </section>

  <section class="bloque">
    <div class="wrap">
      <h2>Qué respuestas involuntarias observamos</h2>
      <p>Durante la inducción el cuerpo responde a su manera. Las registramos sin interpretarlas como síntomas ni diagnósticos:</p>
      <div class="grid3" style="margin-top:1rem">
        {RESPUESTAS.map(([t, d]) => (<article class="card"><h3>{t}</h3><p>{d}</p></article>))}
      </div>
      <p style="margin-top:1rem">Al cerrar, te devolvemos estas notas. Tú decides qué hacer con ellas.</p>
    </div>
  </section>

  <section class="bloque">
    <div class="wrap">
      <h2>Criterios de pre-aprobación y aprobación</h2>
      <div class="grid3" style="margin-top:1rem">
        <article class="card"><h3>Se acepta</h3><p>Personas que buscan bienestar, relajación o acompañamiento emocional, que comprenden el aviso y aceptan el procedimiento por fases.</p></article>
        <article class="card"><h3>Se revisa con cuidado</h3><p>Embarazo, cirugía reciente, trastorno psiquiátrico en tratamiento, duelo reciente o expectativa de sustituir un tratamiento médico.</p></article>
        <article class="card"><h3>Se deriva</h3><p>Urgencias, síntomas sin diagnóstico, ideas de daño a sí mismo o a terceros. En esos casos se canaliza a atención profesional y no se agenda sesión.</p></article>
      </div>
    </div>
  </section>

  <section class="bloque">
    <div class="wrap" style="text-align:center">
      <div class="orn"><span>✦ ✦ ✦</span></div>
      <h2>El siguiente paso es tuyo</h2>
      <div class="btns" style="justify-content:center">
        <a class="btn btn-pri" href={`${base}/cuestionario/`}>Responder las 30 preguntas</a>
        <a class="btn btn-sec" href={CONTACTO.whatsappTexto}>Preguntar antes por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>
